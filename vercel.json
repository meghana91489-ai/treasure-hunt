{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/play", "destination": "/public/play.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
